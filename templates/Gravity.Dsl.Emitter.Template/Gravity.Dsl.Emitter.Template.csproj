<Project Sdk="Microsoft.NET.Sdk">

  <!--
    `dotnet new gravity-emitter` template package. Pack this csproj to produce
    Gravity.Dsl.Emitter.Template.{version}.nupkg, then install with
    `dotnet new install <path-to-nupkg>` (or via NuGet.org once published).
    The template scaffolds an IEmitter-implementing project with deterministic
    build properties and the buildTransitive .props wiring needed for
    Gravity.Dsl.MsBuild to auto-register the emitter on consumers.
  -->

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Gravity.Dsl.Emitter.Template</PackageId>
    <PackageVersion>0.1.0</PackageVersion>
    <Title>Gravity DSL Emitter Template</Title>
    <Authors>Gravity DSL</Authors>
    <Description>dotnet new template that scaffolds a Gravity DSL emitter NuGet package — IEmitter implementation, deterministic build properties, and the buildTransitive .props that auto-registers the assembly with Gravity.Dsl.MsBuild on consumers.</Description>
    <PackageTags>dotnet-new;templates;gravity;dsl;emitter;plugin</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>

    <TargetFramework>net9.0</TargetFramework>

    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>

    <!--
      Template packs ship no code of their own. Suppress the analyzer / banned-API
      machinery the rest of the Gravity tree applies, so the template's own
      `dotnet build` does not need to honour rules that only apply to the code
      this template generates.
    -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content\**\*"
             Exclude="content\**\bin\**;content\**\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>

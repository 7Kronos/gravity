<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      Deterministic output is non-negotiable: every reference emitter ships
      byte-identical artifacts for identical inputs (Gravity constitution,
      "Deterministic output"). The properties below restate that contract on
      this project so it carries the same expectations when shipped from a
      repo outside the Gravity tree.
    -->
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>MyEmitter</PackageId>
    <PackageVersion>0.1.0</PackageVersion>
    <Description>Custom emitter for the Gravity DSL.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>gravity dsl emitter target-name-placeholder</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Gravity.Dsl.Ast" Version="gravity-package-version-placeholder" />
    <PackageReference Include="Gravity.Dsl.Emitter" Version="gravity-package-version-placeholder" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Cross-package wiring (FR-224). NuGet auto-imports buildTransitive/<PackageId>.props
      at the top of the consuming .csproj. The props contributes this emitter's DLL
      to <GravityDslEmitterAssembly>, which Gravity.Dsl.MsBuild then passes to the
      GravityDslGenTask. Consumers add a <PackageReference> for both this package
      and Gravity.Dsl.MsBuild — the registration is automatic from there.
    -->
    <None Include="buildTransitive\MyEmitter.props"
          Pack="true"
          PackagePath="buildTransitive\MyEmitter.props" />
  </ItemGroup>

</Project>
